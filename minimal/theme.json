{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"color": "#f3eddc",
					"name": "Old Paper",
					"slug": "old-paper"
				},
				{
					"color": "#e8dfca",
					"name": "Paper Shadow",
					"slug": "paper-shadow"
				},
				{
					"color": "#25221d",
					"name": "Typewriter Ink",
					"slug": "typewriter-ink"
				},
				{
					"color": "#686054",
					"name": "Faded Ink",
					"slug": "faded-ink"
				},
				{
					"color": "#7b2f25",
					"name": "Editor Red",
					"slug": "editor-red"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1040px"
		},
		"spacing": {
			"blockGap": true,
			"units": ["%", "px", "em", "rem", "vh", "vw"]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Georgia, 'Times New Roman', Times, serif",
					"name": "Reading Serif",
					"slug": "reading-serif"
				},
				{
					"fontFamily": "'Special Elite', 'Courier New', Courier, monospace",
					"name": "Typewriter",
					"slug": "typewriter"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.82rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": {"min": "1.45rem", "max": "1.9rem"},
					"name": "Large",
					"size": "1.9rem",
					"slug": "large"
				},
				{
					"fluid": {"min": "2.2rem", "max": "3.65rem"},
					"name": "Extra Large",
					"size": "3.65rem",
					"slug": "x-large"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|old-paper",
			"text": "var:preset|color|typewriter-ink"
		},
		"elements": {
			"button": {
				"border": {"radius": "0"},
				"color": {
					"background": "var:preset|color|typewriter-ink",
					"text": "var:preset|color|old-paper"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|typewriter",
					"fontSize": "var:preset|font-size|small"
				}
			},
			"caption": {
				"color": {"text": "var:preset|color|faded-ink"},
				"typography": {
					"fontFamily": "var:preset|font-family|typewriter",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.45"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|typewriter",
					"fontWeight": "400",
					"lineHeight": "1.18"
				}
			},
			"link": {
				"color": {"text": "var:preset|color|editor-red"}
			}
		},
		"spacing": {"blockGap": "1.45rem"},
		"typography": {
			"fontFamily": "var:preset|font-family|reading-serif",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.72"
		}
	},
	"templateParts": [
		{"area": "header", "name": "header", "title": "Header"},
		{"area": "footer", "name": "footer", "title": "Footer"}
	]
}
